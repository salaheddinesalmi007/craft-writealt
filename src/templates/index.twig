{% extends "_layouts/cp" %}
{% set title = 'WriteAlt - AI Alt Text & SEO' %}
{% set selectedSubnavItem = 'writealt' %}
{% do view.registerAssetBundle('writealt\\assetbundles\\WriteAltAsset') %}

{% block content %}
<div id="writealt-app"
     data-assets-url="{{ actionUrl('writealt/dashboard/assets')|e('html_attr') }}"
     data-credits-url="{{ actionUrl('writealt/dashboard/credits')|e('html_attr') }}"
     data-generate-url="{{ actionUrl('writealt/dashboard/generate')|e('html_attr') }}"
     data-optimize-url="{{ actionUrl('writealt/dashboard/optimize')|e('html_attr') }}"
     data-csrf-token="{{ craft.app.request.csrfToken|e('html_attr') }}">
  <header class="writealt-header">
    <div>
      <div class="writealt-brand"><span class="writealt-logo" aria-hidden="true"><svg viewBox="0 0 256 256" focusable="false"><rect x="12" y="12" width="232" height="232" rx="48" fill="#fff" stroke="#2d6cdf" stroke-width="14"/><path d="M56 166l43-53 31 34 24-27 46 46" fill="none" stroke="#2d6cdf" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"/><circle cx="177" cy="80" r="14" fill="#2d6cdf"/><path d="M34 132L10 156l24 24M222 132l24 24-24 24" fill="none" stroke="#9aa4b2" stroke-width="12" stroke-linecap="round"/></svg></span><strong>Write<span>Alt</span></strong></div>
      <p class="writealt-eyebrow">ASSET WORKSPACE</p>
      <h1>WriteAlt for Craft CMS</h1>
      <p class="writealt-lead">Generate useful alt text and optimize image assets without leaving Craft.</p>
    </div>
    <div class="writealt-header-actions">
      <a class="btn" href="{{ cpUrl('settings/plugins/writealt') }}">⚙ Settings</a>
      <button class="btn submit" type="button" data-action="refresh">↻ Refresh assets</button>
      <span class="writealt-connection" data-connection>Checking connection...</span>
      <span class="writealt-credits" data-credits>Credits —</span>
    </div>
  </header>
  <div class="writealt-toolbar">
    <div class="writealt-toolbar-left">
      <label class="writealt-select-all"><input type="checkbox" data-select-all><span></span><strong>Select all visible</strong></label>
      <div class="writealt-tabs" role="tablist">
        <button class="active" type="button" data-filter="all">All</button>
        <button type="button" data-filter="missing">Missing alt text</button>
        <button type="button" data-filter="needsOptimization">Needs optimization</button>
        <button type="button" data-filter="optimized">Optimized</button>
      </div>
    </div>
    <div class="writealt-actions">
      <span data-count>Loading assets...</span>
      <button class="btn" type="button" data-action="generate-selected">✦ Generate selected</button>
      <button class="btn" type="button" data-action="optimize-selected">⚡ Optimize selected</button>
    </div>
  </div>
  <div class="writealt-status" data-status aria-live="polite"></div>
  <div class="writealt-grid" data-grid></div>
</div>
{% endblock %}
